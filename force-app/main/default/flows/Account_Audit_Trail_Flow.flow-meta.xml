<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Did_Name_Change</name>
        <label>Did Name Change?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Name_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Name</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Name</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Name_Audit</targetReference>
            </connector>
            <label>Name Changed</label>
        </rules>
        <rules>
            <name>IsActive_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.IsActive__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.IsActive__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_IsActive_Audit</targetReference>
            </connector>
            <label>IsActive Changed</label>
        </rules>
    </decisions>
    <description>Creates audit trail records when Account Name or IsActive is changed.</description>
    <environments>Default</environments>
    <formulas>
        <name>Current_Date_Time</name>
        <dataType>DateTime</dataType>
        <expression>$Flow.CurrentDateTime</expression>
    </formulas>
    <formulas>
        <name>Current_Date_Timee</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <interviewLabel>Account Audit Trail Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account Audit Trail Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_IsActive_Audit</name>
        <label>Create IsActive Audit</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Account__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Changed_By__c</field>
            <value>
                <elementReference>$Record.LastModifiedById</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Changed_Date__c</field>
            <value>
                <elementReference>Current_Date_Timee</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Field_Changed__c</field>
            <value>
                <elementReference>IsActive_Changed</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>New_Value__c</field>
            <value>
                <elementReference>$Record.IsActive__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Previous_Value__c</field>
            <value>
                <elementReference>$Record__Prior.IsActive__c</elementReference>
            </value>
        </inputAssignments>
        <object>Account_Audit_Trail__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_Name_Audit</name>
        <label>Create Name Audit</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Account__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Changed_By__c</field>
            <value>
                <elementReference>$Record.LastModifiedById</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Changed_Date__c</field>
            <value>
                <elementReference>Current_Date_Time</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Field_Changed__c</field>
            <value>
                <stringValue>Name</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>New_Value__c</field>
            <value>
                <elementReference>$Record.Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Previous_Value__c</field>
            <value>
                <elementReference>$Record__Prior.Name</elementReference>
            </value>
        </inputAssignments>
        <object>Account_Audit_Trail__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Did_Name_Change</targetReference>
        </connector>
        <object>Account</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
