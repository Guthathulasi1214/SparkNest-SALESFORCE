<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Minimum_Customer_Budget</fullName>
    <active>true</active>
    <description>Prevents users from entering a customer budget below ₹1,000</description>
    <errorConditionFormula>AND( NOT( ISBLANK( Customer_Budget__c ) ) , Customer_Budget__c &lt;1000
)</errorConditionFormula>
    <errorDisplayField>Customer_Budget__c</errorDisplayField>
    <errorMessage>Customer minimum budget should be ₹1,000</errorMessage>
</ValidationRule>
